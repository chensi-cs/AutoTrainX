# ========== 项目专属忽略规则（你指定的文件/目录） ==========
# IDEA 编辑器配置目录
.idea/
# Python 编译缓存目录
__pycache__/
# 数据集压缩包
abalone.zip
# 数据集解压目录
abalone/

# ========== Python 项目通用忽略规则 ==========
# 虚拟环境目录
.venv/
venv/
env/
ENV/
# 环境变量文件（包含密钥等敏感信息）
.env
# 字节编译/优化/DLL文件
*.py[cod]
*$py.class
# C 扩展
*.so
# 分发/打包
dist/
build/
*.egg-info/
.eggs/
# 测试/覆盖率报告
htmlcov/
.coverage
.coverage.*
.pytest_cache/
# 日志文件
*.log
# 操作系统临时文件
.DS_Store
Thumbs.db
# Jupyter 笔记本
.ipynb_checkpoints
# 持久化数据目录

.vscode/